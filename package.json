{
  "name": "eson",
  "version": "1.2.1",
  "description": "ESON — ExtendScript Object Notation: a strict JSON parser/stringify library for ExtendScript (ES3) engines",
  "type": "module",
  "main": "dist/eson-core.esm.mjs",
  "scripts": {
    "build": "node eson-build.mjs",
    "build:accel": "node eson-build.mjs --accel",
    "test": "node tests/eson-test.mjs && node tests/native-lane.mjs",
    "typecheck": "npx tsc --noEmit -p .",
    "benchmark": "node tests/benchmark.mjs",
    "live-verify": "node tests/eson-live-verify.mjs",
    "accel-live": "node tests/eson-accel-live.mjs",
    "native-build": "powershell -ExecutionPolicy Bypass -File native/build.ps1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/thelabcorner/eson.git"
  },
  "keywords": [
    "json",
    "extendscript",
    "es3",
    "parser",
    "stringify",
    "strict"
  ]
}